{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ramelo",
  "mainBinaryName": "ramelo",
  "version": "1.1.0",
  "identifier": "fr.ramelo.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ramelo",
        "width": 1440,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 640,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Steve Chadaud",
    "copyright": "© 2026 Steve Chadaud",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxQ0VENzVENUQ3RkI4QTQKUldTa3VIOWRYZGZPOFI1R3prUmd3RTVqRTlNcUh5ZHAyczhNUGdjY1ByajNiZlYraWJYbmdsTW4K",
      "endpoints": [
        "https://github.com/SteveChd/Ramelo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
